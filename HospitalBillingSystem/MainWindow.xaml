<Window x:Class="HospitalBillingSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hospital Billing System - Dashboard" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2E7D32" Padding="15">
            <Grid>
                <TextBlock x:Name="txtWelcome" Text="Welcome, User" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <Button x:Name="btnLogout" Content="Logout" Width="100" Height="35" Background="White" 
                        Foreground="#2E7D32" FontWeight="Bold" HorizontalAlignment="Right" Click="BtnLogout_Click" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar Menu -->
            <Border Grid.Column="0" Background="#424242" Padding="0">
                <StackPanel>
                    <Button x:Name="btnDashboard" Content="Dashboard" Style="{StaticResource MenuButtonStyle}" Click="BtnDashboard_Click"/>
                    <Button x:Name="btnPatients" Content="Patients" Style="{StaticResource MenuButtonStyle}" Click="BtnPatients_Click"/>
                    <Button x:Name="btnDoctors" Content="Doctors" Style="{StaticResource MenuButtonStyle}" Click="BtnDoctors_Click"/>
                    <Button x:Name="btnBilling" Content="Billing" Style="{StaticResource MenuButtonStyle}" Click="BtnBilling_Click"/>
                    <Button x:Name="btnPharmacy" Content="Pharmacy" Style="{StaticResource MenuButtonStyle}" Click="BtnPharmacy_Click"/>
                    <Button x:Name="btnLab" Content="Laboratory" Style="{StaticResource MenuButtonStyle}" Click="BtnLab_Click"/>
                    <Button x:Name="btnReports" Content="Reports" Style="{StaticResource MenuButtonStyle}" Click="BtnReports_Click"/>
                </StackPanel>
            </Border>

            <!-- Content Area -->
            <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden" Background="#F5F5F5"/>
        </Grid>
    </Grid>

    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#616161"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
</Window>
