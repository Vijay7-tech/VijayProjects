<Page x:Class="HospitalBillingSystem.Views.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Reports">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Reports" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Report Filters -->
                <Border Background="White" Padding="15" Margin="0,0,0,10" BorderBrush="LightGray" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Report Filters" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="From Date" FontSize="14" Margin="0,0,0,5"/>
                                <DatePicker x:Name="dpFromDate" Height="35" FontSize="14"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="To Date" FontSize="14" Margin="0,0,0,5"/>
                                <DatePicker x:Name="dpToDate" Height="35" FontSize="14"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Report Type" FontSize="14" Margin="0,0,0,5"/>
                                <ComboBox x:Name="cmbReportType" Height="35" FontSize="14">
                                    <ComboBoxItem Content="Billing Summary" IsSelected="True"/>
                                    <ComboBoxItem Content="Patient List"/>
                                    <ComboBoxItem Content="Doctor Performance"/>
                                    <ComboBoxItem Content="Pharmacy Sales"/>
                                    <ComboBoxItem Content="Lab Tests"/>
                                    <ComboBoxItem Content="Revenue Report"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                            <Button Content="Generate Report" Width="140" Height="40" Margin="0,0,10,0" Click="BtnGenerateReport_Click" 
                                    Background="#2196F3" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand"/>
                            <Button Content="Export to Excel" Width="140" Height="40" Margin="0,0,10,0" Click="BtnExportExcel_Click" 
                                    Background="#4CAF50" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand"/>
                            <Button Content="Export to PDF" Width="140" Height="40" Click="BtnExportPDF_Click" 
                                    Background="#FF5722" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Report Display -->
                <Border Background="White" Padding="15" BorderBrush="LightGray" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="txtReportTitle" Text="Report Results" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                        <DataGrid x:Name="dgReport" AutoGenerateColumns="True" IsReadOnly="True" 
                                  SelectionMode="Single" CanUserAddRows="False" AlternatingRowBackground="LightGray" 
                                  MaxHeight="500"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
