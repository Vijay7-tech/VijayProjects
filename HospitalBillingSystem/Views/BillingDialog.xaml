<Window x:Class="HospitalBillingSystem.Views.BillingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Billing Details" Height="650" Width="600"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock x:Name="txtTitle" Text="New Billing" FontSize="24" FontWeight="Bold"/>
                <TextBlock x:Name="txtBillingType" Text="Type: OP" FontSize="16" Margin="0,5,0,15"/>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <TextBlock Text="Invoice Number" FontSize="14" Margin="0,0,0,5"/>
                <TextBox x:Name="txtInvoiceNumber" Height="35" FontSize="14" Padding="5" IsReadOnly="True"/>

                <TextBlock Text="Patient *" FontSize="14" Margin="0,10,0,5"/>
                <ComboBox x:Name="cmbPatient" Height="35" FontSize="14" Padding="5" DisplayMemberPath="FullName" SelectedValuePath="Id"/>

                <TextBlock Text="Doctor" FontSize="14" Margin="0,10,0,5"/>
                <ComboBox x:Name="cmbDoctor" Height="35" FontSize="14" Padding="5" DisplayMemberPath="FullName" SelectedValuePath="Id"/>

                <TextBlock Text="Consultation Charges" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtConsultationCharges" Height="35" FontSize="14" Padding="5" Text="0" TextChanged="CalculateTotal"/>

                <TextBlock Text="Medicine Charges" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtMedicineCharges" Height="35" FontSize="14" Padding="5" Text="0" TextChanged="CalculateTotal"/>

                <TextBlock Text="Lab Charges" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtLabCharges" Height="35" FontSize="14" Padding="5" Text="0" TextChanged="CalculateTotal"/>

                <TextBlock Text="Room Charges (IP)" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtRoomCharges" Height="35" FontSize="14" Padding="5" Text="0" TextChanged="CalculateTotal"/>

                <TextBlock Text="Other Charges" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtOtherCharges" Height="35" FontSize="14" Padding="5" Text="0" TextChanged="CalculateTotal"/>

                <TextBlock Text="Discount" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtDiscount" Height="35" FontSize="14" Padding="5" Text="0" TextChanged="CalculateTotal"/>

                <Border Background="#E3F2FD" Padding="10" Margin="0,10,0,0">
                    <TextBlock x:Name="txtTotalAmount" Text="Total Amount: ₹0.00" FontSize="20" FontWeight="Bold" Foreground="#1976D2"/>
                </Border>

                <TextBlock Text="Payment Method" FontSize="14" Margin="0,10,0,5"/>
                <ComboBox x:Name="cmbPaymentMethod" Height="35" FontSize="14" Padding="5">
                    <ComboBoxItem Content="Cash" IsSelected="True"/>
                    <ComboBoxItem Content="Card"/>
                    <ComboBoxItem Content="UPI"/>
                    <ComboBoxItem Content="Insurance"/>
                </ComboBox>

                <TextBlock Text="Payment Status" FontSize="14" Margin="0,10,0,5"/>
                <ComboBox x:Name="cmbPaymentStatus" Height="35" FontSize="14" Padding="5">
                    <ComboBoxItem Content="Paid" IsSelected="True"/>
                    <ComboBoxItem Content="Pending"/>
                    <ComboBoxItem Content="Partial"/>
                </ComboBox>

                <TextBlock Text="Notes" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtNotes" Height="60" FontSize="14" Padding="5" TextWrapping="Wrap" AcceptsReturn="True"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="btnSave" Content="Save" Width="100" Height="40" Margin="0,0,10,0" Click="BtnSave_Click" 
                        Background="#4CAF50" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand"/>
                <Button Content="Cancel" Width="100" Height="40" Click="BtnCancel_Click" 
                        Background="#757575" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
