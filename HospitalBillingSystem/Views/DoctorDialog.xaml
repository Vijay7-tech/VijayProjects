<Window x:Class="HospitalBillingSystem.Views.DoctorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Doctor Details" Height="550" Width="500"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="txtTitle" Text="Add New Doctor" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

            <StackPanel Grid.Row="1">
                <TextBlock Text="Doctor ID" FontSize="14" Margin="0,0,0,5"/>
                <TextBox x:Name="txtDoctorId" Height="35" FontSize="14" Padding="5"/>

                <TextBlock Text="Full Name *" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtFullName" Height="35" FontSize="14" Padding="5"/>

                <TextBlock Text="Specialization" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtSpecialization" Height="35" FontSize="14" Padding="5"/>

                <TextBlock Text="Qualification" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtQualification" Height="35" FontSize="14" Padding="5"/>

                <TextBlock Text="Phone" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtPhone" Height="35" FontSize="14" Padding="5"/>

                <TextBlock Text="Email" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtEmail" Height="35" FontSize="14" Padding="5"/>

                <TextBlock Text="Consultation Fee" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtConsultationFee" Height="35" FontSize="14" Padding="5" Text="0"/>

                <TextBlock Text="Department" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtDepartment" Height="35" FontSize="14" Padding="5"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Save" Width="100" Height="40" Margin="0,0,10,0" Click="BtnSave_Click" 
                        Background="#4CAF50" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand"/>
                <Button Content="Cancel" Width="100" Height="40" Click="BtnCancel_Click" 
                        Background="#757575" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
