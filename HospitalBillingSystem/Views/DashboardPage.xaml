<Page x:Class="HospitalBillingSystem.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Dashboard">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Dashboard" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

            <UniformGrid Grid.Row="1" Columns="4" Rows="2" Margin="0,20,0,0">
                <!-- Patients Card -->
                <Border Background="#2196F3" Margin="10" Padding="20" CornerRadius="5">
                    <StackPanel>
                        <TextBlock Text="Total Patients" FontSize="16" Foreground="White"/>
                        <TextBlock x:Name="txtTotalPatients" Text="0" FontSize="36" FontWeight="Bold" Foreground="White" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Doctors Card -->
                <Border Background="#4CAF50" Margin="10" Padding="20" CornerRadius="5">
                    <StackPanel>
                        <TextBlock Text="Total Doctors" FontSize="16" Foreground="White"/>
                        <TextBlock x:Name="txtTotalDoctors" Text="0" FontSize="36" FontWeight="Bold" Foreground="White" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Today's Billing Card -->
                <Border Background="#FF9800" Margin="10" Padding="20" CornerRadius="5">
                    <StackPanel>
                        <TextBlock Text="Today's Revenue" FontSize="16" Foreground="White"/>
                        <TextBlock x:Name="txtTodayRevenue" Text="₹0" FontSize="36" FontWeight="Bold" Foreground="White" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Pending Tests Card -->
                <Border Background="#9C27B0" Margin="10" Padding="20" CornerRadius="5">
                    <StackPanel>
                        <TextBlock Text="Pending Tests" FontSize="16" Foreground="White"/>
                        <TextBlock x:Name="txtPendingTests" Text="0" FontSize="36" FontWeight="Bold" Foreground="White" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Medicines Low Stock Card -->
                <Border Background="#F44336" Margin="10" Padding="20" CornerRadius="5">
                    <StackPanel>
                        <TextBlock Text="Low Stock Medicines" FontSize="16" Foreground="White"/>
                        <TextBlock x:Name="txtLowStockMeds" Text="0" FontSize="36" FontWeight="Bold" Foreground="White" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- OP Billing Card -->
                <Border Background="#00BCD4" Margin="10" Padding="20" CornerRadius="5">
                    <StackPanel>
                        <TextBlock Text="OP Billing (Today)" FontSize="16" Foreground="White"/>
                        <TextBlock x:Name="txtOPBilling" Text="0" FontSize="36" FontWeight="Bold" Foreground="White" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- IP Billing Card -->
                <Border Background="#673AB7" Margin="10" Padding="20" CornerRadius="5">
                    <StackPanel>
                        <TextBlock Text="IP Billing (Today)" FontSize="16" Foreground="White"/>
                        <TextBlock x:Name="txtIPBilling" Text="0" FontSize="36" FontWeight="Bold" Foreground="White" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Pharmacy Sales Card -->
                <Border Background="#795548" Margin="10" Padding="20" CornerRadius="5">
                    <StackPanel>
                        <TextBlock Text="Pharmacy Sales (Today)" FontSize="16" Foreground="White"/>
                        <TextBlock x:Name="txtPharmacySales" Text="₹0" FontSize="36" FontWeight="Bold" Foreground="White" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Grid>
    </ScrollViewer>
</Page>
