<Window x:Class="HospitalBillingSystem.Views.PharmacySaleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pharmacy Sale" Height="500" Width="500"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="New Pharmacy Sale" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Sale Number" FontSize="14" Margin="0,0,0,5"/>
            <TextBox x:Name="txtSaleNumber" Height="35" FontSize="14" Padding="5" IsReadOnly="True"/>

            <TextBlock Text="Patient (Optional)" FontSize="14" Margin="0,10,0,5"/>
            <ComboBox x:Name="cmbPatient" Height="35" FontSize="14" Padding="5" DisplayMemberPath="FullName" SelectedValuePath="Id"/>

            <TextBlock Text="Medicine *" FontSize="14" Margin="0,10,0,5"/>
            <ComboBox x:Name="cmbMedicine" Height="35" FontSize="14" Padding="5" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="CmbMedicine_SelectionChanged"/>

            <TextBlock Text="Unit Price" FontSize="14" Margin="0,10,0,5"/>
            <TextBox x:Name="txtUnitPrice" Height="35" FontSize="14" Padding="5" IsReadOnly="True" Text="0"/>

            <TextBlock Text="Quantity *" FontSize="14" Margin="0,10,0,5"/>
            <TextBox x:Name="txtQuantity" Height="35" FontSize="14" Padding="5" Text="1" TextChanged="CalculateTotal"/>

            <Border Background="#E3F2FD" Padding="10" Margin="0,10,0,0">
                <TextBlock x:Name="txtTotalPrice" Text="Total: ₹0.00" FontSize="18" FontWeight="Bold" Foreground="#1976D2"/>
            </Border>

            <TextBlock Text="Payment Method" FontSize="14" Margin="0,10,0,5"/>
            <ComboBox x:Name="cmbPaymentMethod" Height="35" FontSize="14" Padding="5">
                <ComboBoxItem Content="Cash" IsSelected="True"/>
                <ComboBoxItem Content="Card"/>
                <ComboBoxItem Content="UPI"/>
            </ComboBox>

            <TextBlock Text="Notes" FontSize="14" Margin="0,10,0,5"/>
            <TextBox x:Name="txtNotes" Height="60" FontSize="14" Padding="5" TextWrapping="Wrap" AcceptsReturn="True"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Save Sale" Width="110" Height="40" Margin="0,0,10,0" Click="BtnSave_Click" 
                    Background="#4CAF50" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand"/>
            <Button Content="Cancel" Width="100" Height="40" Click="BtnCancel_Click" 
                    Background="#757575" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
