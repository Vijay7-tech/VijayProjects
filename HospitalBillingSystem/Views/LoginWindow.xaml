<Window x:Class="HospitalBillingSystem.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hospital Billing System - Login" Height="400" Width="500"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2E7D32" Padding="20">
            <StackPanel>
                <TextBlock Text="Hospital Billing System" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Login to continue" FontSize="14" Foreground="White" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Login Form -->
        <Border Grid.Row="1" Padding="40">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Username" FontSize="14" Margin="0,0,0,5"/>
                <TextBox x:Name="txtUsername" Height="35" FontSize="14" Padding="5"/>

                <TextBlock Text="Password" FontSize="14" Margin="0,20,0,5"/>
                <PasswordBox x:Name="txtPassword" Height="35" FontSize="14" Padding="5"/>

                <TextBlock Text="Role" FontSize="14" Margin="0,20,0,5"/>
                <ComboBox x:Name="cmbRole" Height="35" FontSize="14" Padding="5">
                    <ComboBoxItem Content="Admin" IsSelected="True"/>
                    <ComboBoxItem Content="Doctor"/>
                    <ComboBoxItem Content="Receptionist"/>
                    <ComboBoxItem Content="Pharmacist"/>
                    <ComboBoxItem Content="LabTechnician"/>
                </ComboBox>

                <Button x:Name="btnLogin" Content="Login" Height="40" FontSize="16" FontWeight="Bold" 
                        Background="#2E7D32" Foreground="White" Margin="0,30,0,0" Click="BtnLogin_Click" Cursor="Hand"/>

                <TextBlock x:Name="txtError" Text="" Foreground="Red" FontSize="12" Margin="0,10,0,0" 
                           HorizontalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
