<Window x:Class="HospitalBillingSystem.Views.MedicineDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Medicine Details" Height="600" Width="500"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="txtTitle" Text="Add New Medicine" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

            <StackPanel Grid.Row="1">
                <TextBlock Text="Medicine Code" FontSize="14" Margin="0,0,0,5"/>
                <TextBox x:Name="txtMedicineCode" Height="35" FontSize="14" Padding="5"/>

                <TextBlock Text="Name *" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtName" Height="35" FontSize="14" Padding="5"/>

                <TextBlock Text="Generic Name" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtGenericName" Height="35" FontSize="14" Padding="5"/>

                <TextBlock Text="Manufacturer" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtManufacturer" Height="35" FontSize="14" Padding="5"/>

                <TextBlock Text="Category" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtCategory" Height="35" FontSize="14" Padding="5"/>

                <TextBlock Text="Price *" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtPrice" Height="35" FontSize="14" Padding="5" Text="0"/>

                <TextBlock Text="Stock Quantity *" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtStockQuantity" Height="35" FontSize="14" Padding="5" Text="0"/>

                <TextBlock Text="Reorder Level" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtReorderLevel" Height="35" FontSize="14" Padding="5" Text="10"/>

                <TextBlock Text="Expiry Date" FontSize="14" Margin="0,10,0,5"/>
                <DatePicker x:Name="dpExpiryDate" Height="35" FontSize="14" Padding="5"/>

                <TextBlock Text="Description" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtDescription" Height="60" FontSize="14" Padding="5" TextWrapping="Wrap" AcceptsReturn="True"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Save" Width="100" Height="40" Margin="0,0,10,0" Click="BtnSave_Click" 
                        Background="#4CAF50" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand"/>
                <Button Content="Cancel" Width="100" Height="40" Click="BtnCancel_Click" 
                        Background="#757575" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
