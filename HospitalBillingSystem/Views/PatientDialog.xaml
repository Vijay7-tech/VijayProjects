<Window x:Class="HospitalBillingSystem.Views.PatientDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Patient Details" Height="600" Width="500"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="txtTitle" Text="Add New Patient" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

            <StackPanel Grid.Row="1">
                <TextBlock Text="Patient ID" FontSize="14" Margin="0,0,0,5"/>
                <TextBox x:Name="txtPatientId" Height="35" FontSize="14" Padding="5"/>

                <TextBlock Text="Full Name *" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtFullName" Height="35" FontSize="14" Padding="5"/>

                <TextBlock Text="Date of Birth *" FontSize="14" Margin="0,10,0,5"/>
                <DatePicker x:Name="dpDateOfBirth" Height="35" FontSize="14" Padding="5"/>

                <TextBlock Text="Gender *" FontSize="14" Margin="0,10,0,5"/>
                <ComboBox x:Name="cmbGender" Height="35" FontSize="14" Padding="5">
                    <ComboBoxItem Content="Male"/>
                    <ComboBoxItem Content="Female"/>
                    <ComboBoxItem Content="Other"/>
                </ComboBox>

                <TextBlock Text="Phone" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtPhone" Height="35" FontSize="14" Padding="5"/>

                <TextBlock Text="Email" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtEmail" Height="35" FontSize="14" Padding="5"/>

                <TextBlock Text="Address" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtAddress" Height="35" FontSize="14" Padding="5"/>

                <TextBlock Text="Blood Group" FontSize="14" Margin="0,10,0,5"/>
                <ComboBox x:Name="cmbBloodGroup" Height="35" FontSize="14" Padding="5">
                    <ComboBoxItem Content="A+"/>
                    <ComboBoxItem Content="A-"/>
                    <ComboBoxItem Content="B+"/>
                    <ComboBoxItem Content="B-"/>
                    <ComboBoxItem Content="AB+"/>
                    <ComboBoxItem Content="AB-"/>
                    <ComboBoxItem Content="O+"/>
                    <ComboBoxItem Content="O-"/>
                </ComboBox>

                <TextBlock Text="Medical History" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtMedicalHistory" Height="70" FontSize="14" Padding="5" TextWrapping="Wrap" AcceptsReturn="True"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Save" Width="100" Height="40" Margin="0,0,10,0" Click="BtnSave_Click" 
                        Background="#4CAF50" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand"/>
                <Button Content="Cancel" Width="100" Height="40" Click="BtnCancel_Click" 
                        Background="#757575" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
