<Window x:Class="HospitalBillingSystem.Views.LabTestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lab Test Details" Height="550" Width="500"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="txtTitle" Text="New Lab Test" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

            <StackPanel Grid.Row="1">
                <TextBlock Text="Test Code" FontSize="14" Margin="0,0,0,5"/>
                <TextBox x:Name="txtTestCode" Height="35" FontSize="14" Padding="5" IsReadOnly="True"/>

                <TextBlock Text="Test Name *" FontSize="14" Margin="0,10,0,5"/>
                <ComboBox x:Name="cmbTestName" Height="35" FontSize="14" Padding="5" IsEditable="True">
                    <ComboBoxItem Content="Complete Blood Count (CBC)"/>
                    <ComboBoxItem Content="Blood Sugar Test"/>
                    <ComboBoxItem Content="Lipid Profile"/>
                    <ComboBoxItem Content="Liver Function Test"/>
                    <ComboBoxItem Content="Kidney Function Test"/>
                    <ComboBoxItem Content="Thyroid Test"/>
                    <ComboBoxItem Content="Urine Test"/>
                    <ComboBoxItem Content="X-Ray"/>
                    <ComboBoxItem Content="ECG"/>
                    <ComboBoxItem Content="Ultrasound"/>
                </ComboBox>

                <TextBlock Text="Patient *" FontSize="14" Margin="0,10,0,5"/>
                <ComboBox x:Name="cmbPatient" Height="35" FontSize="14" Padding="5" DisplayMemberPath="FullName" SelectedValuePath="Id"/>

                <TextBlock Text="Doctor" FontSize="14" Margin="0,10,0,5"/>
                <ComboBox x:Name="cmbDoctor" Height="35" FontSize="14" Padding="5" DisplayMemberPath="FullName" SelectedValuePath="Id"/>

                <TextBlock Text="Test Cost *" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtTestCost" Height="35" FontSize="14" Padding="5" Text="0"/>

                <TextBlock Text="Status" FontSize="14" Margin="0,10,0,5"/>
                <ComboBox x:Name="cmbStatus" Height="35" FontSize="14" Padding="5">
                    <ComboBoxItem Content="Pending" IsSelected="True"/>
                    <ComboBoxItem Content="Completed"/>
                    <ComboBoxItem Content="Cancelled"/>
                </ComboBox>

                <TextBlock Text="Result" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtResult" Height="60" FontSize="14" Padding="5" TextWrapping="Wrap" AcceptsReturn="True"/>

                <TextBlock Text="Notes" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="txtNotes" Height="60" FontSize="14" Padding="5" TextWrapping="Wrap" AcceptsReturn="True"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Save" Width="100" Height="40" Margin="0,0,10,0" Click="BtnSave_Click" 
                        Background="#4CAF50" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand"/>
                <Button Content="Cancel" Width="100" Height="40" Click="BtnCancel_Click" 
                        Background="#757575" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
