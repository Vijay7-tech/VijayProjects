## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio 2015/2017 cache/options directory
.vs/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NuGet Packages
*.nupkg
# The packages folder can be ignored because of Package Restore
**/packages/*
!**/packages/build/

# Visual Studio cache files
*.cache
*.cachefile
*.VisualState.xml
*.log
*.vsidx
*.vspscc
*.vssscc

# Resharper files
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# SQLite databases
*.db
*.db-shm
*.db-wal

# Others
*.pidb
*.svclog
*.scc
